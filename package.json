{
  "name": "om-live-center",
  "version": "1.0.0",
  "private": true,
  "description": "OM Live Center - live, actualites, mercato et donnees de match sourcees",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "check": "node scripts/check-pack.mjs && npm run build && npm test",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "serve:static": "http-server web-widget -p 5173 -c-1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "http-server": "^14.1.1",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
